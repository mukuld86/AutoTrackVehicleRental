@model List<AutoTrackVehicleRental.Web.Models.VehicleViewModel>

@{
    ViewData["Title"] = "Vehicles";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>AutoTrack Vehicle Rental</h2>
        <a asp-action="AddVehicle"
           class="btn btn-primary">
            Add New Vehicle
        </a>
    </div>

    <!-- Search -->
    <form asp-action="SearchVehicle"
          method="post"
          class="row g-2 mb-4">
        <div class="col-md-6">
            <input type="text"
                   name="type"
                   class="form-control"
                   placeholder="Search vehicle by type" />
        </div>
        <div class="col-auto">
            <button type="submit"
                    class="btn btn-success">
                Search
            </button>
        </div>
        <div class="col-auto">
            <a asp-action="ViewAllVehicles"
               class="btn btn-secondary">
                Clear
            </a>
        </div>
    </form>

    <!-- Vehicle Table -->
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Vehicle ID</th>
                <th>Vehicle Name</th>
                <th>Type</th>
                <th>Availability</th>
                <th>Date of Registration</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var vehicle in Model)
                {
                    <tr>
                        <td>
                            @vehicle.VehicleId
                        </td>
                        <td>
                            @vehicle.VehicleName
                        </td>
                        <td>
                            @vehicle.Type
                        </td>
                        <td>
                            @if (vehicle.AvailabilityStatus)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Not Available
                                </span>
                            }
                        </td>
                        <td>
                            @vehicle.DateOfRegistration.ToString("dd-MM-yyyy")
                        </td>
                        <td>
                            <a asp-action="UpdateVehicle"
                               asp-route-vehicleId="@vehicle.VehicleId"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>
                            <a asp-action="RemoveVehicle"
                               asp-route-vehicleId="@vehicle.VehicleId"
                               class="btn btn-danger btn-sm">
                                Remove
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6"
                        class="text-center">
                        No vehicles found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
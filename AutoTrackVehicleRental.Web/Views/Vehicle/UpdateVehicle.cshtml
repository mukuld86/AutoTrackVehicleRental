@model AutoTrackVehicleRental.Web.Models.VehicleViewModel

@{
    ViewData["Title"] = "Update Vehicle";
}

<div class="container mt-4">

    <h2>Update Vehicle</h2>

    <hr />

    <form asp-action="UpdateVehicle" method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <!-- Vehicle ID -->

        <input asp-for="VehicleId"
               type="hidden" />

        <div class="mb-3">

            <label asp-for="VehicleName"
                   class="form-label">
                Vehicle Name
            </label>

            <input asp-for="VehicleName"
                   class="form-control" />

            <span asp-validation-for="VehicleName"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Type"
                   class="form-label">
                Vehicle Type
            </label>

            <input asp-for="Type"
                   class="form-control" />

            <span asp-validation-for="Type"
                  class="text-danger">
            </span>

        </div>

        <div class="form-check mb-3">

            <input asp-for="AvailabilityStatus"
                   class="form-check-input" />

            <label asp-for="AvailabilityStatus"
                   class="form-check-label">
                Available
            </label>

        </div>

        <div class="mb-3">

            <label asp-for="DateOfRegistration"
                   class="form-label">
                Date of Registration
            </label>

            <input asp-for="DateOfRegistration"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="DateOfRegistration"
                  class="text-danger">
            </span>

        </div>

        <button type="submit"
                class="btn btn-primary">
            Update Vehicle
        </button>

        <a asp-action="ViewAllVehicles"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}